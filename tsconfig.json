{
  "include": [
    "types/**/*.d.ts",
    "lib/**/*",
    "extension.js",
    "prefs.js",
    "./node_modules/@girs/*/*-ambient.d.ts"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "target": "ES2022",
    "skipLibCheck": true
  }
}
